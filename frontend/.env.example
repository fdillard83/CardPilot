# Create a local .env file and replace these placeholders with local credentials.
OPENAI_API_KEY=your_api_key_here

# Optional replaceable web-image evidence provider. Encode the private Google
# service-account JSON as Base64 and store it only on the server/Render.
# Never prefix any of these values with VITE_.
GOOGLE_VISION_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id_here
GOOGLE_CLOUD_CREDENTIALS_BASE64=your_base64_encoded_service_account_json_here
GOOGLE_VISION_TIMEOUT_MS=3000

# Server-side eBay Production credentials. Never prefix these with VITE_.
EBAY_CLIENT_ID=your_ebay_production_client_id_here
EBAY_CLIENT_SECRET=your_ebay_production_client_secret_here
EBAY_MARKETPLACE_ID=EBAY_US

# Separate per-seller eBay authorization. Keep sandbox until test listings pass.
EBAY_SELL_ENVIRONMENT=sandbox
EBAY_SELL_CLIENT_ID=your_ebay_sandbox_client_id_here
EBAY_SELL_CLIENT_SECRET=your_ebay_sandbox_client_secret_here
EBAY_REDIRECT_URI_NAME=your_ebay_sandbox_runame_here
EBAY_TOKEN_ENCRYPTION_KEY=generate_a_long_random_server_only_secret
EBAY_SCHEDULER_SECRET=generate_a_separate_long_random_scheduler_secret

# Server-side The Card API key for experimental completed-sales comparisons.
# Never prefix this with VITE_.
THE_CARD_API_KEY=your_the_card_api_key_here

# Optional server-side Pokémon TCG API key. Catalog search works at reduced
# unauthenticated limits when this is left unset. Never prefix it with VITE_.
POKEMON_TCG_API_KEY=your_pokemon_tcg_api_key_here

# Optional durable collection storage and accounts. Leave local during setup;
# switch to supabase only after running the included SQL migration. These are
# server-side values and must never be prefixed with VITE_.
COLLECTION_STORAGE_MODE=local
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_CARD_IMAGES_BUCKET=card-images
APP_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
# Comma-separated account emails allowed to open CardPilot's private admin dashboard.
ADMIN_EMAILS=owner@example.com
# Turn on only while importing this computer's existing .data collection into
# your signed-in account, then turn it off and restart CardPilot.
LOCAL_COLLECTION_IMPORT_ENABLED=false

# Optional overrides
OPENAI_MODEL=gpt-5.6-sol
OPENAI_FAST_MODEL=gpt-5.4-mini
PORT=8787
